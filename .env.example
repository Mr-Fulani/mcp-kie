# Development only. Never commit real secrets, including in this file.
KIE_SECRET_SOURCE=env
KIE_MCP_API_KEY=
# This project deliberately never falls back to KIE_API_KEY.
KIE_ALLOWED_UPLOAD_ROOT=~/kie-workspace/uploads
KIE_ALLOWED_DOWNLOAD_ROOT=~/kie-workspace/results
KIE_MAX_UPLOAD_MB=50
KIE_MAX_DOWNLOAD_MB=100
KIE_TIMEOUT_SECONDS=120
KIE_MAX_RETRIES=3
KIE_TASK_TIMEOUT_SEC=900
KIE_MAX_CONCURRENT_TASKS=5
KIE_USAGE_LEDGER_PATH=~/.local/share/kie-mcp/usage.db
KIE_MAX_TASK_COST_USD=1.00
KIE_MAX_SESSION_COST_USD=5.00
KIE_MAX_DAILY_COST_USD=10.00
KIE_MAX_TOTAL_COST_USD=100.00
KIE_APPROVAL_TTL_SEC=300
KIE_DUPLICATE_TTL_SEC=900
KIE_MCP_TRANSPORT=stdio
# Unknown cost requires explicit per-request user risk acknowledgement; local task-limit reserve is not a KIE price cap.
# KIE_OWNER_QUOTE_PATH=~/.config/kie-mcp/quote.json
# For local Linux/WSL use secret_file in private owner TOML, not this env example.
# KIE_SECRET_FILE=~/.config/kie-mcp/media.key
